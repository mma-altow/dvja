{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',

  // Gemeinsames Preset — Kontext A (Pilot). Siehe docs/spec.md §9.
  //
  // JSON5 statt JSON, weil Renovate unbekannte Schlüssel ablehnt: ein
  // "//kommentar"-Feld ist ein Konfigurationsfehler, kein Kommentar.
  // Am 01.09.2026 gemessen: "Invalid configuration option: //automerge".
  extends: ['config:recommended'],

  // Auf Azure DevOps laut Zielbild nicht vorhanden; im Piloten hilfreich.
  dependencyDashboard: true,

  // PFLICHT (spec.md §11.3, V12): sonst überschreibt der nächste Lauf die
  // Branch des Migrations-Agenten, der auf DIESELBE Branch schreibt.
  rebaseWhen: 'never',

  // Ausdrücklich aus, nicht bloß ungesetzt (spec.md §9). Keine
  // Automerge-Klasse, auch nicht für Test-Abhängigkeiten.
  automerge: false,

  // Aktualitätsupdates: fünf gleichzeitig (spec.md §9).
  // Sicherheits-PRs heben das unten ausdrücklich auf.
  prConcurrentLimit: 5,
  prHourlyLimit: 0,

  // Der Reconciler erkennt die Schreibklasse am Label (spec.md §10).
  labels: ['dependencies', 'manifest-klasse'],

  // Damit Patch- und Minor-Sprünge unterscheidbar bleiben — die Leiter
  // aus §7 braucht das.
  separateMinorPatch: true,

  vulnerabilityAlerts: {
    // Sicherheits-PRs: KEINE Obergrenze. "Security umgeht das Limit" war
    // Dependabot-Verhalten und gilt bei Renovate nicht von selbst — wird die
    // Ausnahme nicht gesetzt, deckelt prConcurrentLimit genau die Klasse, die
    // nicht gedeckelt werden darf, und die Lücke wird still (spec.md §9).
    enabled: true,
    prConcurrentLimit: 0,
    prHourlyLimit: 0,
    labels: ['dependencies', 'manifest-klasse', 'security'],
    // Im Piloten und auf dem Entwicklungszweig wartet ein Sicherheitsfix auf
    // niemanden (spec.md §13). Auf eingefrorenen Linien kehrt das
    // Mindestalter zurück.
    minimumReleaseAge: null,
  },

  packageRules: [
    {
      // Kontext A (Pilot): Aktualitätsupdates sind AN — rein
      // schwachstellengetriebene Updates heben auf die kleinste schließende
      // Version, daraus entstehen fast keine Major-Sprünge und der
      // Migrations-Agent hätte kein Material. Pilot-Eigenschaft, keine
      // Produkteigenschaft (spec.md §9).
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'Aktualität (gruppiert)',
      schedule: ['before 6am on monday'],
    },
    {
      // Major einzeln, nie gruppiert — jeder Major ist eine eigene Entscheidung.
      matchUpdateTypes: ['major'],
      groupName: null,
    },
  ],
}
